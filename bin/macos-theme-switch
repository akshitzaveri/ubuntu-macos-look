#!/usr/bin/env bash
# Apply the full light or dark look. No argument: pick by time of day (light 07:00–17:59).
#   macos-theme-switch [light|dark]
mode=${1:-}
if [[ -z $mode ]]; then
  h=$((10#$(date +%H)))
  (( h >= 7 && h < 18 )) && mode=light || mode=dark
fi
[[ $mode == light ]] && C=Light || C=Dark
[[ $mode == light ]] && icons=MacTahoe || icons=MacTahoe-dark
[[ $mode == light ]] && wall=MacTahoe-day.jpeg || wall=MacTahoe-night.jpeg

I=org.gnome.desktop.interface
gsettings set $I color-scheme "prefer-$mode"
gsettings set $I gtk-theme "MacTahoe-$C-blue"
gsettings set $I icon-theme "$icons"
dconf write /org/gnome/shell/extensions/user-theme/name "'MacTahoe-$C-blue-fixed'"
uri="file://$HOME/.local/share/backgrounds/MacTahoe/$wall"
gsettings set org.gnome.desktop.background picture-uri "$uri"
gsettings set org.gnome.desktop.background picture-uri-dark "$uri"

# libadwaita (GTK4) apps read ~/.config/gtk-4.0/gtk.css
G4=$HOME/.config/gtk-4.0
[[ -f $G4/gtk-$C.css ]] && ln -sfn "$G4/gtk-$C.css" "$G4/gtk.css"
echo "macos-theme-switch: $mode"
